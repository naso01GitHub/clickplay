{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "cmd /c .cursor\\hooks\\save-conversation.cmd",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "cmd /c .cursor\\hooks\\save-conversation.cmd",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "cmd /c .cursor\\hooks\\save-conversation.cmd",
        "timeout": 20
      }
    ],
    "sessionEnd": [
      {
        "command": "cmd /c .cursor\\hooks\\save-conversation.cmd",
        "timeout": 20
      }
    ]
  }
}
