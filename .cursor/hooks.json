{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/save-conversation.js",
        "matcher": "UserPromptSubmit"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/save-conversation.js",
        "matcher": "AgentResponse"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/save-conversation.js",
        "matcher": "Stop"
      }
    ]
  }
}
