<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClickPlay.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
        x:Class="ClickPlay.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ClickPlay"
        Width="960"
        Height="720"
        MinWidth="720"
        MinHeight="560">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ComboBox.compact">
            <Setter Property="MaxWidth" Value="200" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxWidth" Value="180" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBox.narrow">
            <Setter Property="MaxWidth" Value="72" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="NumericUpDown.clock">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="MaxWidth" Value="58" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="FormatString" Value="00" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="ClipValueToMinMax" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- Status banner at the top: icon + colored left edge + tinted background per StatusKind. -->
        <Style Selector="Border.status">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="5,1,1,1" />
            <Setter Property="BorderBrush" Value="#64B5F6" />
            <Setter Property="Background" Value="#2264B5F6" />
        </Style>
        <Style Selector="Border.status TextBlock.statusIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#64B5F6" />
        </Style>
        <Style Selector="Border.status SelectableTextBlock.statusText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.status.working">
            <Setter Property="BorderBrush" Value="#90A4AE" />
            <Setter Property="Background" Value="#2290A4AE" />
        </Style>
        <Style Selector="Border.status.working TextBlock.statusIcon">
            <Setter Property="Foreground" Value="#B0BEC5" />
        </Style>
        <Style Selector="Border.status.success">
            <Setter Property="BorderBrush" Value="#66BB6A" />
            <Setter Property="Background" Value="#2866BB6A" />
        </Style>
        <Style Selector="Border.status.success TextBlock.statusIcon">
            <Setter Property="Foreground" Value="#81C784" />
        </Style>
        <Style Selector="Border.status.success SelectableTextBlock.statusText">
            <Setter Property="Foreground" Value="#C8E6C9" />
        </Style>
        <Style Selector="Border.status.warning">
            <Setter Property="BorderBrush" Value="#FFB300" />
            <Setter Property="Background" Value="#28FFB300" />
        </Style>
        <Style Selector="Border.status.warning TextBlock.statusIcon">
            <Setter Property="Foreground" Value="#FFCA28" />
        </Style>
        <Style Selector="Border.status.warning SelectableTextBlock.statusText">
            <Setter Property="Foreground" Value="#FFE082" />
        </Style>
        <Style Selector="Border.status.error">
            <Setter Property="BorderBrush" Value="#EF5350" />
            <Setter Property="Background" Value="#33EF5350" />
        </Style>
        <Style Selector="Border.status.error TextBlock.statusIcon">
            <Setter Property="Foreground" Value="#FF8A80" />
        </Style>
        <Style Selector="Border.status.error SelectableTextBlock.statusText">
            <Setter Property="Foreground" Value="#FFCDD2" />
        </Style>

        <!-- SMTP fields while Search runs: stars only, not editable. -->
        <Style Selector="TextBox.locked">
            <Setter Property="PasswordChar" Value="*" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style Selector="TextBox.short">
            <Setter Property="MaxWidth" Value="88" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top"
                Classes="status"
                Classes.error="{Binding StatusIsError}"
                Classes.warning="{Binding StatusIsWarning}"
                Classes.success="{Binding StatusIsSuccess}"
                Classes.working="{Binding StatusIsWorking}"
                Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="statusIcon" Text="{Binding StatusIcon}" VerticalAlignment="Center" />
                <SelectableTextBlock Grid.Column="1"
                                     Classes="statusText"
                                     Text="{Binding StatusMessage}"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <Expander Header="Email (SMTP) — password kept in the OS secure store"
                      IsExpanded="{Binding IsMailExpanded}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6" Margin="0,8,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" VerticalAlignment="Center" />
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding SmtpHost}" Classes.locked="{Binding IsSearching}"
                                 PlaceholderText="pick a provider or type any SMTP server" />
                        <ComboBox Grid.Column="1"
                                  Width="230"
                                  ItemsSource="{Binding SmtpHostPresets}"
                                  SelectedItem="{Binding SelectedSmtpPreset}"
                                  PlaceholderText="Known providers"
                                  IsEnabled="{Binding !IsSearching}"
                                  ToolTip.Tip="{Binding SelectedSmtpPreset.Note, FallbackValue='Pick a provider to fill Host and Port'}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox Text="{Binding SmtpPort}" Classes="short" Classes.locked="{Binding IsSearching}" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding SmtpPortOptions}"
                                  SelectedItem="{Binding SelectedSmtpPortOption}"
                                  PlaceholderText="Ports"
                                  IsEnabled="{Binding !IsSearching}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="User" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SmtpUser}" Classes.locked="{Binding IsSearching}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0" Text="{Binding SmtpPassword}" PasswordChar="*" Classes.locked="{Binding IsSearching}" />
                        <CheckBox Grid.Column="1"
                                  Width="230"
                                  Content="Remember login"
                                  IsChecked="{Binding RememberLogin}"
                                  ToolTip.Tip="Off: User and Password are not saved and start empty next time. Turning it off erases the saved login now." />
                    </Grid>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="From" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MailFrom}" Classes.locked="{Binding IsSearching}" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Subject" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MailSubject}"
                             PlaceholderText="mail subject = this text + location + time slot" />
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="To" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Text="{Binding MailTo}"
                             AcceptsReturn="True"
                             MinHeight="72"
                             TextWrapping="Wrap"
                             PlaceholderText="one address per line" />
                </Grid>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Load sports"
                        Command="{Binding LoadSportsCommand}"
                        IsEnabled="{Binding !IsBusy}" />
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding CanSearch}" />
                <Button Content="Stop"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding CanStop}" />
                <TextBlock Text="Debug" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox Width="88"
                          ItemsSource="{Binding DebugOptions}"
                          SelectedItem="{Binding Debug}"
                          ToolTip.Tip="true = show Chromium, false = headless" />
            </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="*,380" ColumnSpacing="16">
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="Auto,Auto,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Start date" FontWeight="SemiBold" FontSize="12" />
                    <CalendarDatePicker Grid.Row="1"
                                        Grid.Column="0"
                                        SelectedDate="{Binding SelectedDate}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Days ahead" FontWeight="SemiBold" FontSize="12" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Classes="short"
                             Text="{Binding DaysAheadText}"
                             PlaceholderText="7" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Repeat (min)" FontWeight="SemiBold" FontSize="12" />
                    <TextBox Grid.Row="1"
                             Grid.Column="2"
                             Classes="short"
                             Text="{Binding RepeatText}"
                             PlaceholderText="1–60"
                             MaxLength="2" />
                </Grid>
                <Grid ColumnDefinitions="150,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Weekdays"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <NumericUpDown Classes="clock" Minimum="0" Maximum="23" Value="{Binding WeekdayFromHour}" ToolTip.Tip="Hour 0–23" />
                        <TextBlock Text=":" VerticalAlignment="Center" FontSize="12" />
                        <NumericUpDown Classes="clock" Minimum="0" Maximum="59" Value="{Binding WeekdayFromMinute}" ToolTip.Tip="Minutes 0–59" />
                        <TextBlock Text="to" VerticalAlignment="Center" FontSize="12" Margin="8,0" />
                        <NumericUpDown Classes="clock" Minimum="0" Maximum="23" Value="{Binding WeekdayToHour}" ToolTip.Tip="Hour 0–23" />
                        <TextBlock Text=":" VerticalAlignment="Center" FontSize="12" />
                        <NumericUpDown Classes="clock" Minimum="0" Maximum="59" Value="{Binding WeekdayToMinute}" ToolTip.Tip="Minutes 0–59" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Weekends / holidays"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <NumericUpDown Classes="clock" Minimum="0" Maximum="23" Value="{Binding WeekendFromHour}" ToolTip.Tip="Hour 0–23" />
                        <TextBlock Text=":" VerticalAlignment="Center" FontSize="12" />
                        <NumericUpDown Classes="clock" Minimum="0" Maximum="59" Value="{Binding WeekendFromMinute}" ToolTip.Tip="Minutes 0–59" />
                        <TextBlock Text="to" VerticalAlignment="Center" FontSize="12" Margin="8,0" />
                        <NumericUpDown Classes="clock" Minimum="0" Maximum="23" Value="{Binding WeekendToHour}" ToolTip.Tip="Hour 0–23" />
                        <TextBlock Text=":" VerticalAlignment="Center" FontSize="12" />
                        <NumericUpDown Classes="clock" Minimum="0" Maximum="59" Value="{Binding WeekendToMinute}" ToolTip.Tip="Minutes 0–59" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
                <StackPanel Spacing="6" IsVisible="{Binding IsSportsVisible}">
                    <TextBlock Text="Sport" FontWeight="SemiBold" FontSize="12" />
                    <ComboBox Classes="compact"
                              ItemsSource="{Binding Sports}"
                              SelectedItem="{Binding SelectedSport}"
                              PlaceholderText="Select a sport">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding IsCityVisible}">
                    <TextBlock Text="City" FontWeight="SemiBold" FontSize="12" />
                    <ComboBox Classes="compact"
                              ItemsSource="{Binding Cities}"
                              SelectedItem="{Binding SelectedCity}"
                              PlaceholderText="Select a city">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <DockPanel Grid.Row="2" IsVisible="{Binding IsLocationsPanelVisible}">
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,0,0,6">
                    <TextBlock Text="Locations" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <Button Content="Select all" Command="{Binding SelectAllLocationsCommand}" />
                    <Button Content="Clear" Command="{Binding ClearLocationsCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Locations}" MinHeight="80" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocationItemViewModel">
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsSelected}"
                                      FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Grid>

            <DockPanel Grid.Column="1"
                       VerticalAlignment="Stretch"
                       MaxWidth="380">
                <TextBlock DockPanel.Dock="Top" Text="Results" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Results}"
                         MinHeight="80"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="11"
                                       TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
