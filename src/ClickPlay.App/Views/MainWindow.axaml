<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClickPlay.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="800"
        x:Class="ClickPlay.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ClickPlay"
        Width="980"
        Height="820"
        MinWidth="720"
        MinHeight="640">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <Expander Header="Email (SMTP) — stored later in app data, not in source">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6" Margin="0,8,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SmtpHost}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SmtpPort}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="User" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SmtpUser}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SmtpPassword}" PasswordChar="•" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="From" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MailFrom}" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="To" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <TextBox Grid.Row="5"
                             Grid.Column="1"
                             Text="{Binding MailTo}"
                             AcceptsReturn="True"
                             MinHeight="72"
                             TextWrapping="Wrap"
                             PlaceholderText="one address per line" />
                </Grid>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Load sports"
                        Command="{Binding LoadSportsCommand}"
                        IsEnabled="{Binding !IsBusy}" />
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding CanSearch}" />
                <TextBlock Text="Headless" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox Width="88"
                          ItemsSource="{Binding HeadlessOptions}"
                          SelectedItem="{Binding Headless}"
                          ToolTip.Tip="true = no browser window, false = show Chromium" />
            </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,*" ColumnSpacing="16" RowSpacing="12">
            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="8">
                <TextBlock Text="Sport" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Sports}"
                          SelectedItem="{Binding SelectedSport}"
                          PlaceholderText="Select a sport"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel IsVisible="{Binding IsCityVisible}" Spacing="8">
                    <TextBlock Text="City" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Cities}"
                              SelectedItem="{Binding SelectedCity}"
                              PlaceholderText="Select a city"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="8">
                <TextBlock Text="Days ahead" FontWeight="SemiBold" />
                <TextBox Text="{Binding DaysAheadText}" PlaceholderText="7" />

                <TextBlock Text="Weekdays (Mon–Fri)" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding WeekdayFromText}" PlaceholderText="18:00" />
                    <TextBlock Grid.Column="1" Text="to" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding WeekdayToText}" PlaceholderText="21:00" />
                </Grid>

                <TextBlock Text="Weekends and holidays" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding WeekendFromText}" PlaceholderText="10:00" />
                    <TextBlock Grid.Column="1" Text="to" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding WeekendToText}" PlaceholderText="20:00" />
                </Grid>
            </StackPanel>

            <DockPanel Grid.Column="0" Grid.Row="1" IsVisible="{Binding IsLocationsVisible}">
                <TextBlock DockPanel.Dock="Top" Text="Locations" FontWeight="SemiBold" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                    <Button Content="Select all" Command="{Binding SelectAllLocationsCommand}" />
                    <Button Content="Clear" Command="{Binding ClearLocationsCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Locations}" MinHeight="180">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocationItemViewModel">
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1" Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="Results" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Results}" MinHeight="180" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
